# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# --- Binance ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# --- Symbol universe ---
# ALL = every active USDT-M perpetual future; CUSTOM = use CUSTOM_SYMBOLS
SYMBOL_MODE=ALL
CUSTOM_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Cap the ALL universe to the top-N by 24h quote volume (0 = no cap, scan ALL coins).
MAX_SYMBOLS=0

# --- Structural Fractal & Trendline Parameters (Active runtime pipeline) ---
STRUCTURAL_FRACTAL_PERIOD=30
STRUCTURAL_MIN_SPAN=65
TRENDLINE_MIN_PIVOT_DIST=20
TRENDLINE_MIN_TOUCHES=2
TRENDLINE_TOUCH_TOL_ATR=0.35
TRENDLINE_MAX_VIOLATIONS=1

# --- Detection tuning (Legacy / auxiliary parameters) ---
LB_LEFT=30
LB_RIGHT=20
COOLDOWN_BARS=5
SYM_TOL_PCT=10.0
LVL_TOL_PCT=3.0
MIN_SIZE_PCT=0.5
MIN_ATR_MULT=1.0
EMA_PERIOD=200
ATR_PERIOD=14

USE_ATR_BRK=true
BREAK_ATR_MULT=1.0
BREAK_PCT=0.3

MIN_RR=1.0
SL_PCT_TARGET_DIST=75.0
USE_R_MULTIPLE_TP=true
TP1_R_MULT=1.0
TP2_R_MULT=2.0
TP3_R_MULT=3.0
TAKER_FEE_PCT=0.04


CANDLES_LOOKBACK=500
SCAN_INTERVAL_SEC=60
TRACKER_INTERVAL_SEC=30

DB_PATH=bot/data/trading.db
LOG_PATH=bot/data/bot.log

# --- Binance Square ---
SQUARE_ENABLED=false
SQUARE_DRY_RUN=true
BINANCE_SQUARE_OPENAPI_KEY=
SQUARE_MAX_POSTS_PER_DAY=50
SQUARE_MAX_TEXT_LENGTH=600
SQUARE_MAX_RETRIES=3
SQUARE_FAILURE_THRESHOLD=5

