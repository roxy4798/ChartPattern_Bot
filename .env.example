# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# --- Binance ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# --- Symbol universe ---
# ALL = every active USDT-M perpetual future; CUSTOM = use CUSTOM_SYMBOLS
SYMBOL_MODE=ALL
CUSTOM_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Cap the ALL universe to the top-N by 24h quote volume (0 = no cap).
# Start small on a local machine before scaling up.
MAX_SYMBOLS=40

# --- Detection tuning (defaults mirror the Pine Script indicator) ---
LB_LEFT=10
LB_RIGHT=10
COOLDOWN_BARS=5
SYM_TOL_PCT=10.0
LVL_TOL_PCT=3.0
MIN_SIZE_PCT=0.5
MIN_ATR_MULT=1.0
EMA_PERIOD=200
ATR_PERIOD=14

USE_ATR_BRK=true
BREAK_ATR_MULT=1.0
BREAK_PCT=0.3

MIN_RR=1.0
SL_PCT_TARGET_DIST=25.0
TP1_FRACTION=0.5
TP2_FRACTION=1.0
TP3_FRACTION=1.5
TAKER_FEE_PCT=0.04

CANDLES_LOOKBACK=500
SCAN_INTERVAL_SEC=60
TRACKER_INTERVAL_SEC=30

DB_PATH=bot/data/trading.db
LOG_PATH=bot/data/bot.log
